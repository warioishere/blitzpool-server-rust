# blitzpool-rust full-setup — environment overrides.
#
# Copy to `.env` (gitignored) and uncomment whatever you need to
# override. `docker compose` reads `.env` from the same directory as
# the compose file automatically.

# ── Postgres ────────────────────────────────────────────────────────
# Default DB name is `blitzpool`. When attaching to an existing TS-pool
# install whose DB is still called `public_pool`, override here:
#PG_DATABASE=public_pool
#PG_USER=postgres
#PG_PASSWORD=postgres

# ── Redis / Valkey ──────────────────────────────────────────────────
#REDIS_PASSWORD=
#REDIS_MAX_MEMORY=4096mb

# ── Bundled Bitcoin Core node ───────────────────────────────────────
# The node image builds Bitcoin Core 32.1. For another release set all
# three: the version and the SHA-256 of its two Linux tarballs from that
# release's SHA256SUMS (check its signatures first). Set
# [tdp] bitcoin_core_version in the pool config to the same major release;
# the pool refuses to start against a node of another one.
#BITCOIN_CORE_VER=32.1
#BITCOIN_CORE_SHA256_X86_64=
#BITCOIN_CORE_SHA256_AARCH64=

# ── Pool logging verbosity ──────────────────────────────────────────
#RUST_LOG=info,blitzpool=debug
