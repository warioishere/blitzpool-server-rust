# Optional. Copy to .env next to docker-compose.yml and uncomment what you need.

# Postgres password; default `postgres`. The database is not published on the
# host. If you set one, put the same value into [database] password in
# blitzpool.toml. It only takes effect on a fresh database volume.
#PG_PASSWORD=

# Your own Bitcoin Core node (31 or 32, set [tdp] bitcoin_core_version
# to match): the host directory holding its IPC socket
# (node.sock). Leave unset when running the bundled node (--profile bitcoin).
#BITCOIN_IPC_DIR=/var/lib/bitcoin-ipc

# Bundled node only: main, test4 or regtest. Must match `network` in
# blitzpool.toml (main = mainnet, test4 = testnet4).
#BITCOIN_CHAIN=main

# Bundled node only: it builds Bitcoin Core 32.1. For another release set
# all three, the version and the SHA-256 of its two Linux tarballs from that
# release's SHA256SUMS (check its signatures first), and set
# [tdp] bitcoin_core_version to the same major release.
#BITCOIN_CORE_VER=32.1
#BITCOIN_CORE_SHA256_X86_64=
#BITCOIN_CORE_SHA256_AARCH64=

#REDIS_MAX_MEMORY=1gb
#RUST_LOG=info
